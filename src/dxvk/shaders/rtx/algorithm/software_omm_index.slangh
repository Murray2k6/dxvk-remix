#pragma once

// Maps barycentrics to the micro-triangle index of an opacity micromap.
//
// Written after the Vulkan specification: the ray traversal chapter ("the integer u and v ... clamping ... mapped into a
// linear index with a space filling curve ...") and its opacity micromap reference code
// (BarycentricsToSpaceFillingCurveIndex, Copyright 2022-2026 The Khronos Group Inc., SPDX-License-Identifier: CC-BY-4.0).
// u is the weight of the triangle's second vertex and v of its third, as CandidateTriangleBarycentrics() returns them.
// rtx.alphaBake.softwareOmmSelfTest checks it against the bake's inverse mapping (micromeshDistToBary,
// bake_opacity_micromap_utils.slangh) for every micro-triangle of levels 0-12.

// Spreads the low 16 bits of x to the even bit positions.
uint softOmmSpreadBits(uint x)
{
  x = (x | (x << 8u)) & 0x00ff00ffu;
  x = (x | (x << 4u)) & 0x0f0f0f0fu;
  x = (x | (x << 2u)) & 0x33333333u;
  x = (x | (x << 1u)) & 0x55555555u;
  return x;
}

uint softOmmBarycentricsToIndex(float2 barycentrics, uint level)
{
  const float u = clamp(barycentrics.x, 0.0f, 1.0f);
  const float v = clamp(barycentrics.y, 0.0f, 1.0f);
  const uint numSteps = 1u << level;

  // Quantize the barycentrics.
  const float fu = u * float(numSteps);
  const float fv = v * float(numSteps);
  uint iu = uint(fu);
  uint iv = uint(fv);
  const float uf = fu - float(iu);
  const float vf = fv - float(iv);

  iu = min(iu, numSteps - 1u);
  iv = min(iv, numSteps - 1u);

  // Keep iu + iv inside the triangle.
  const uint iuv = iu + iv;
  if (iuv >= numSteps)
  {
    iu -= iuv - numSteps + 1u;
  }

  // The third discrete barycentric, complemented. The upper half of a cell is the flipped micro-triangle.
  uint iw = ~(iu + iv);
  if (uf + vf >= 1.0f && iuv < numSteps - 1u)
  {
    --iw;
  }

  // b0 holds the even bits of the curve index and b1 the odd bits.
  uint b0 = ~(iu ^ iw);
  b0 &= numSteps - 1u;
  const uint t = (iu ^ iv) & b0;

  uint f = t;
  f ^= f >> 1u;
  f ^= f >> 2u;
  f ^= f >> 4u;
  f ^= f >> 8u;
  const uint b1 = ((f ^ iu) & ~b0) | t;

  return softOmmSpreadBits(b0) | (softOmmSpreadBits(b1) << 1u);
}
