#pragma once

// rtx.frameFeatures.validate. Included only under FRAME_FEATURES_VALIDATE (the validation variants of the Full G-buffer
// and direct kernels), so no other variant carries it. Needs common_bindings.slangh (LightSamplingStats) and the Surface type.

#include "rtx/pass/frame_features_validate.h"

void frameFeaturesNoteSeen(uint bits)
{
  const uint waveBits = WaveActiveBitOr(bits);
  if (WaveIsFirstLane() && waveBits != 0u)
  {
    InterlockedOr(LightSamplingStats[FRAME_FEATURES_SEEN_SLOT], waveBits);
  }
}

// Returns whether a surface has non-identity legacy (fixed-function) state, matching hasLegacy (rtSurfaceHasLegacyState,
// rtx_materials.h). That is texture operations other than the defaults, a TFactor or vertex-colour argument, texture-factor
// blend, texgen, a texture transform, a spritesheet, a clip plane or the eye.
bool frameFeaturesSurfaceHasLegacy(Surface surface)
{
  const uint colorArg1 = uint(surface.textureColorArg1Source);
  const uint colorArg2 = uint(surface.textureColorArg2Source);
  const uint alphaArg1 = uint(surface.textureAlphaArg1Source);
  const uint alphaArg2 = uint(surface.textureAlphaArg2Source);
  const bool textureOps =
    colorArg1 != uint(RtTextureArgSource::Texture) || colorArg2 != uint(RtTextureArgSource::None) ||
    uint(surface.textureColorOperation) != uint(DxvkRtTextureOperation::Modulate) ||
    alphaArg1 != uint(RtTextureArgSource::Texture) || alphaArg2 != uint(RtTextureArgSource::None) ||
    uint(surface.textureAlphaOperation) != uint(DxvkRtTextureOperation::SelectArg1);
  const uint tFactor = uint(RtTextureArgSource::TFactor);
  const uint vertexColor = uint(RtTextureArgSource::VertexColor0);
  const bool factorOrColorArg =
    colorArg1 == tFactor || colorArg1 == vertexColor || colorArg2 == tFactor || colorArg2 == vertexColor ||
    alphaArg1 == tFactor || alphaArg1 == vertexColor || alphaArg2 == tFactor || alphaArg2 == vertexColor;
  const bool eye = surface.isEye;
  // The eye basis aliases the texture transform rows.
  const bool textureTransform = !eye &&
    (any(asfloat(surface.data11) != vec4(1.0, 0.0, 0.0, 0.0)) || any(asfloat(surface.data12) != vec4(0.0, 1.0, 0.0, 0.0)));
  const bool spritesheet = surface.spriteSheetFPS != 0 || surface.spriteSheetRows != 1 || surface.spriteSheetCols != 1;
  return textureOps || factorOrColorArg || surface.isTextureFactorBlend || surface.texcoordGenerationMode != 0 ||
         textureTransform || spritesheet || surface.isClipPlaneEnabled || eye;
}
