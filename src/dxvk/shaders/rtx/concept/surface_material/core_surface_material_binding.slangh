#pragma once

// The kernel-side access to the per-surface core material records (cb.coreMaterialTable) and the
// legacy records (cb.legacySurfaceTable) through the bindless raw-buffer table, read as uint4 rows. Included only by the
// VISIBILITY_CORE_MATERIAL variants (integrate_direct_*lean_core / *lean_legacy), which the host binds only while both
// tables describe this frame's surfaces.

#include "rtx/concept/surface_material/core_surface_material.slangh"

[allow("parameterBindingsOverlap")]
layout(set = BINDING_SET_BINDLESS_RAW_BUFFER, binding = 0)
StructuredBuffer<uint4> coreMaterialRows[];

CoreSurfaceMaterial coreSurfaceMaterialLoad(uint surfaceIndex)
{
  CoreSurfaceMaterial core;
  [unroll]
  for (uint i = 0; i < 4; ++i)
  {
    core.data[i] = coreMaterialRows[cb.coreMaterialTable][surfaceIndex * 4 + i];
  }
  return core;
}

// The full material record's view of a class 1 (translucent) core record. Bytes 0-35 are the TranslucentSurfaceMaterial
// record verbatim (TranslucentSurfaceMaterial is 36 B), which is all translucentSurfaceMaterialCreate decodes.
MemoryPolymorphicSurfaceMaterial coreSurfaceMaterialTranslucentMemory(uint surfaceIndex)
{
  MemoryPolymorphicSurfaceMaterial memory;
  [unroll]
  for (uint i = 0; i < 3; ++i)
  {
    memory.data[i] = coreMaterialRows[cb.coreMaterialTable][surfaceIndex * 4 + i];
  }
  memory.data[3] = uint4(0u, 0u, 0u, 0u);
  return memory;
}
